{
  "name": "task-manager-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MySQL backend with JWT auth and Task management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:migrate:users": "tsx src/scripts/migrateUserManagement.ts",
    "db:migrate:task-assignees": "tsx src/scripts/migrateTaskAssignees.ts",
    "db:migrate:projects": "tsx src/scripts/migrateProjects.ts",
    "db:migrate:registration-otp": "tsx src/scripts/migrateRegistrationOtp.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
