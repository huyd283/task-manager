# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-super-secret-key-in-production
JWT_EXPIRES_IN=7d

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task_manager

# CORS – origin of the Vite dev server
CLIENT_ORIGIN=http://localhost:5173

# Email OTP (Gmail: use an App Password, not your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM=TOMOTEK <your-address@gmail.com>

# Checkin partner integration (store the partner token in a secret manager)
CHECKIN_BASE_URL=https://checkin.tomotek.vn/
CHECKIN_PARTNER_CODE=TMT_PM
CHECKIN_PARTNER_TOKEN=
CHECKIN_EMPLOYEE_PAGE_SIZE=200
CHECKIN_EMPLOYEE_SYNC_OVERLAP_SECONDS=120

# Firebase Admin SDK: service account JSON in a secret manager, or use ADC
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
